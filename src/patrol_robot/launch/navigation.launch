<launch>

  <!-- All hardware -->
  <include file="$(find patrol_robot)/launch/bringup.launch"/>

  <!-- Map server — loads your saved map -->
  <node name="map_server" pkg="map_server"
        type="map_server" output="screen"
        args="$(find patrol_robot)/maps/living_room.yaml"/>

  <!-- AMCL — localizes robot within saved map -->
  <node name="amcl" pkg="amcl"
        type="amcl" output="screen">
    <param name="base_frame_id"     value="base_link"/>
    <param name="odom_frame_id"     value="odom"/>
    <param name="global_frame_id"   value="map"/>
    <param name="odom_model_type"   value="diff"/>
    <param name="min_particles"     value="500"/>
    <param name="max_particles"     value="2000"/>
    <param name="laser_max_range"   value="8.0"/>
    <param name="laser_max_beams"   value="60"/>
    <param name="update_min_d"      value="0.1"/>
    <param name="update_min_a"      value="0.1"/>
    <param name="resample_interval" value="2"/>
    <!-- Added transform tolerance to handle WiFi lag -->
    <param name="transform_tolerance" value="1.5"/>
    <remap from="scan" to="/scan_filtered"/>
  </node>

  <!-- move_base — path planning + obstacle avoidance -->
  <node name="move_base" pkg="move_base"
        type="move_base" respawn="false" output="screen">
    <rosparam file="$(find patrol_robot)/config/costmap_common.yaml"
              command="load" ns="global_costmap"/>
    <rosparam file="$(find patrol_robot)/config/costmap_common.yaml"
              command="load" ns="local_costmap"/>
    <rosparam file="$(find patrol_robot)/config/local_costmap.yaml"
              command="load"/>
    <rosparam file="$(find patrol_robot)/config/global_costmap.yaml"
              command="load"/>
    <rosparam file="$(find patrol_robot)/config/dwa_local_planner.yaml"
              command="load"/>
    <!-- ADDED THE MOVE_BASE_PARAMS FILE HERE -->
    <rosparam file="$(find patrol_robot)/config/move_base.yaml" command="load"/>
    
    <param name="base_local_planner"
           value="dwa_local_planner/DWAPlannerROS"/>
  </node>

  <!-- RViz for monitoring navigation -->
  <node pkg="rviz" type="rviz" name="rviz"
        args="-d $(find patrol_robot)/rviz/navigation.rviz"
        required="false"/>

</launch>
